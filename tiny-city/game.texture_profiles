path_settings {
  path: "**/textures/generic/*"
  profile: "Default"
}
path_settings {
  path: "**/textures/kenny/*"
  profile: "Default"
}
path_settings {
  path: "**/textures/plane/*"
  profile: "Default"
}
profiles {
  name: "Default"
  platforms {
    os: OS_ID_GENERIC
    formats {
      format: TEXTURE_FORMAT_RGBA
      compressor: "BasisU"
      compressor_preset: "BASISU_HIGH"
    }
    mipmaps: true
  }
}
