[bootstrap]
main_collection = /tiny-city/scenes/world.collectionc
render = /light_and_shadows/render/default.renderc

[script]
shared_state = 1

[display]
width = 1920
height = 1080
high_dpi = 1
samples = 3

[android]
input_method = HiddenInputField

[html5]
scale_mode = stretch

[project]
title = defold-tiny-city
custom_resources = data
dependencies#0 = https://github.com/selimanac/defold-daabbcc3d/archive/refs/heads/main.zip
dependencies#1 = https://github.com/selimanac/defold-graph-pathfinder/archive/refs/heads/main.zip

[native_extension]
app_manifest = /release.appmanifest

[graph_editor]
folder = data
max_gameobject_nodes = 2048
max_nodes = 2048
files = test.json,map1.json

[daabbcc]
max_gameobject_count = 32

[input]
use_accelerometer = 0

[graphics]
texture_profiles = /tiny-city/game.texture_profiles

[shader]
exclude_gles_sm100 = 1

