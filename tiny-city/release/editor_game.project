[bootstrap]
main_collection = /main/test.collectionc
render = /light_and_shadows/render/default.renderc

[script]
shared_state = 1

[display]
width = 1920
height = 1080
high_dpi = 1
samples = 4

[android]
input_method = HiddenInputField

[physics]
gravity_y = 0.0
type = 3D
debug = 0
world_count = 1
use_fixed_timestep = 0

[html5]
scale_mode = stretch

[project]
title = traffic
custom_resources = data
dependencies#0 = https://github.com/selimanac/defold-random/archive/refs/heads/master.zip
dependencies#1 = https://github.com/britzl/extension-imgui/archive/refs/heads/master.zip
dependencies#2 = https://github.com/selimanac/defold-daabbcc3d/archive/refs/heads/main.zip
dependencies#3 = https://github.com/selimanac/defold-graph-pathfinder/archive/refs/heads/main.zip
dependencies#4 = https://github.com/selimanac/defold-uuid4/archive/refs/heads/master.zip

[native_extension]
app_manifest = /release.appmanifest

[graph_editor]
folder = data
max_gameobject_nodes = 2048
max_nodes = 2048
files = test.json,map1.json

[sprite]
max_count = 2048

[factory]
max_count = 2048

[daabbcc]
max_gameobject_count = 2048

[collection]
max_instances = 2048

[collectionfactory]
max_count = 2048

[label]
max_count = 2048

[model]
max_count = 4096

[gui]
max_count = 4096

[input]
use_accelerometer = 0

